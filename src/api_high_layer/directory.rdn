[* 
*   rdn file that will be loaded at the runtime
*   directory.rdn is hight level layer of directory and path manipulations
*   it protect backward complatible in case the native layer API has been
*   upgraded or changed
* *]

[* 
*   rmp_get_current_path: returns current working directory as string?
* *]
rmp_get_current_path defun
    rmp_get_current_path_native call
end

[* 
*   rmp_home_path: returns home directory as string?
* *]
rmp_home_path defun
    rmp_home_path_native call
end

[* 
*   rmp_list_dir: returns directory entries from a path
*   example:
*       (".") rmp_list_dir call -> list? string?
* *]
rmp_list_dir defun
    tha-list let

    tha-list type "list" != if
        null "rmp_list_dir expects list (...)"
    else
        tha-list 0 index
        rmp_list_dir_native call
    end
end

[* 
*   rmp_mkdir: create directory with optional mode
*   example:
*       ("./foo" 755) rmp_mkdir call -> boolean string?
* *]
rmp_mkdir defun
    tha-list let

    tha-list type "list" != if
        false "rmp_mkdir expects list (...)"
    else
        tha-list 0 index
        tha-list 1 index
        rmp_mkdir_native call
    end
end

[* 
*   rmp_rmdir: remove directory
*   example:
*       ("./foo") rmp_rmdir call -> boolean string?
* *]
rmp_rmdir defun
    tha-list let

    tha-list type "list" != if
        false "rmp_rmdir expects list (...)"
    else
        tha-list 0 index
        rmp_rmdir_native call
    end
end
