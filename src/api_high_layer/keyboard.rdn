enum KEY_EQUAL const
enum KEY_NONE const
reset

[* 
*   rmp_get_key: returns a keyboard code or KEY_NONE
* *]
rmp_get_key defun
    rmp_get_key_native call
end

[* 
*   rmp_close_key: restore keyboard input mode used by polling
* *]
rmp_close_key defun
    rmp_close_key_native call
end
